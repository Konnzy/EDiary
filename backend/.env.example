EDIARY_DB_URL=jdbc:postgresql://localhost:5432/ediary
EDIARY_DB_USERNAME=ediary
EDIARY_DB_PASSWORD=change-me
EDIARY_SERVER_PORT=8081
EDIARY_FRONTEND_URL=http://127.0.0.1:5174
EDIARY_PARENT_LINK_CODE_SECRET=replace-with-at-least-32-random-characters

# SMTP credentials must be supplied by the selected mail provider.
EDIARY_MAIL_ENABLED=true
EDIARY_MAIL_HOST=smtp.example.com
EDIARY_MAIL_PORT=587
EDIARY_MAIL_USERNAME=smtp-user
EDIARY_MAIL_PASSWORD=change-me
EDIARY_MAIL_AUTH=true
EDIARY_MAIL_STARTTLS=true
EDIARY_MAIL_STARTTLS_REQUIRED=true
EDIARY_MAIL_SSL=false
EDIARY_MAIL_TEST_CONNECTION=true
EDIARY_MAIL_FROM=no-reply@example.com
EDIARY_MAIL_FROM_NAME=Електронний щоденник
